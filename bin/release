#!/usr/bin/env bash
# =============================================================================
# bin/release — bump version, commit, tag, push
#
# Usage:
#   ./bin/release patch    0.1.0 → 0.1.1
#   ./bin/release minor    0.1.0 → 0.2.0
#   ./bin/release major    0.1.0 → 1.0.0
#
#   ./bin/release patch --notes "Images rebuilt with PHP 8.2.35 (CVE-...)."
#
# --notes puts a text (Markdown) into the annotated tag, below its subject;
# the GitHub release of the tag starts with it (bin/release-notes).
# =============================================================================

set -euo pipefail

# The OpenAPI spec's info.version tracks the application version (CLAUDE.md).
# Only the first two-space-indented "version:" line is info.version.
bump_openapi_version() {
    local spec="$1" version="$2"
    sed -i -E "0,/^  version: \"[^\"]*\"\$/s//  version: \"${version}\"/" "$spec"
    grep -q "^  version: \"${version}\"\$" "$spec"
}

usage() {
    echo "Usage: $0 <patch|minor|major> [--notes <text>]" >&2
    exit 1
}

BUMP="${1:-}"
if [[ "$BUMP" != "patch" && "$BUMP" != "minor" && "$BUMP" != "major" ]]; then
    usage
fi

NOTES=""
if [[ $# -gt 1 ]]; then
    if [[ $# -ne 3 || "$2" != "--notes" || -z "$3" ]]; then
        usage
    fi
    NOTES="$3"
fi

# Ensure working tree is clean.
if [[ -n "$(git status --porcelain)" ]]; then
    echo "Error: working tree is not clean. Commit or stash changes first." >&2
    exit 1
fi

CURRENT=$(cat VERSION)
IFS='.' read -r MAJOR MINOR PATCH <<< "$CURRENT"

case "$BUMP" in
    major) MAJOR=$((MAJOR + 1)); MINOR=0; PATCH=0 ;;
    minor) MINOR=$((MINOR + 1)); PATCH=0 ;;
    patch) PATCH=$((PATCH + 1)) ;;
esac

NEW="${MAJOR}.${MINOR}.${PATCH}"
TAG="v${NEW}"

echo "${NEW}" > VERSION
bump_openapi_version web/openapi.yaml "${NEW}"

git add VERSION web/openapi.yaml
git commit -m "chore: release ${TAG}"
if [[ -n "$NOTES" ]]; then
    # whitespace, not git's default strip: strip drops every line that
    # starts with #, the Markdown headings of the notes too.
    git tag -a --cleanup=whitespace "${TAG}" -m "Release ${TAG}" -m "${NOTES}"
else
    git tag -a "${TAG}" -m "Release ${TAG}"
fi
git push origin main
git push origin "${TAG}"

echo ""
echo "Released ${TAG}"
