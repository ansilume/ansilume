# =============================================================================
# Production nginx image
#
# Bakes in the nginx config and static assets (CSS, JS, SVGs).
# Proxies PHP requests to the app container via FastCGI.
#
# Used by: ghcr.io/ansilume/ansilume-nginx
# =============================================================================

# The same image as docker-compose.yml and the deploy role
# (tests/unit/docker/NginxBaseImageTest.php).
FROM nginx:1.30-alpine-slim

# Remove default config
RUN rm /etc/nginx/conf.d/default.conf

# Bake in the ansilume nginx config
COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf

# Bake in static assets so nginx can serve them directly
COPY web/css      /var/www/web/css
COPY web/js       /var/www/web/js
COPY web/*.svg    /var/www/web/
COPY web/index.php /var/www/web/index.php
# default.conf serves the API spec at /openapi.yaml (tests/unit/docker/NginxImageFilesTest.php)
COPY web/openapi.yaml /var/www/web/openapi.yaml

EXPOSE 80
